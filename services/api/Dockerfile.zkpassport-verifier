# syntax=docker/dockerfile:1.7

FROM oven/bun:1.3.10

WORKDIR /app/services/api

RUN apt-get update \
  && apt-get install -y --no-install-recommends tini \
  && rm -rf /var/lib/apt/lists/*

COPY zkpassport-verifier-runtime/package.json zkpassport-verifier-runtime/bun.lock zkpassport-verifier-runtime/bunfig.toml ./
RUN bun install --frozen-lockfile --production

COPY api/scripts ./scripts
COPY api/src ./src

ENV HOST=0.0.0.0
ENV ZKPASSPORT_VERIFIER_PORT=8794
EXPOSE 8794

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bun", "run", "scripts/zkpassport-verifier-service.ts"]
