# syntax=docker/dockerfile:1.7

FROM oven/bun:1.3.10

WORKDIR /app/services/api

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# The shared local package resolves @neondatabase/serverless from its own
# node_modules, so it gets its own frozen production install first.
COPY shared /app/services/shared
RUN cd /app/services/shared && bun install --frozen-lockfile --production

# Production dependencies install from the dedicated song-preview runtime
# package and its committed lockfile. The full API manifest is never installed
# in this image, so the sibling web/core local packages need no removal step.
COPY song-preview-runtime/package.json song-preview-runtime/bun.lock song-preview-runtime/bunfig.toml ./
RUN bun install --frozen-lockfile --production

COPY api/scripts ./scripts
COPY api/src ./src

ENV HOST=0.0.0.0
ENV SONG_PREVIEW_PORT=8795
ENV SONG_PREVIEW_FFMPEG_BIN=ffmpeg
ENV SONG_DURATION_PROBE_VERSION=1
EXPOSE 8795

CMD ["bun", "run", "scripts/song-preview-service.ts"]
